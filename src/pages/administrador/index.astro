            const cover = card.querySelector("[data-cover]"); cover.textContent = selectedFutureCoverId === item.id ? "Futura portada elegida" : "Usar como futura portada"; cover.classList.toggle("selected", selectedFutureCoverId === item.id); cover.addEventListener("click", () => { selectedFutureCoverId = item.id; if (item.remoteUrl) remoteCover = { url: item.remoteUrl, objectKey: item.objectKey || "", contentType: item.contentType || "" }; renderGallery(); scheduleSave(); });
