        requiredElement("#upload-gallery-r2").addEventListener("click", async () => {
          const batchItems = galleryItems.filter((item) => item.file && (item.status === "pending" || item.status === "error"));
          if (!batchItems.length) return showToast("No hay fotos pendientes para subir.");
          const renderGalleryUploadSummary = (finished = false) => {
            const total = batchItems.length;
            const uploaded = batchItems.filter((item) => item.status === "uploaded").length;
            const errors = batchItems.filter((item) => item.status === "error").length;
            const uploading = batchItems.filter((item) => item.status === "uploading").length;
            const pending = batchItems.filter((item) => item.status === "pending").length;
            const progress = requiredElement("#gallery-upload-progress");
            if (finished && uploaded === total) {
              progress.textContent = "✓ " + total + (total === 1 ? " foto subida" : " fotos subidas");
            } else if (finished || errors) {
              progress.textContent = uploaded + " de " + total + " subidas · " + errors + (errors === 1 ? " con error" : " con errores");
            } else if (uploading || pending) {
              progress.textContent = "Subiendo fotos: " + uploaded + " de " + total + " completadas";
            }
          };
          renderGalleryUploadSummary();
          try {
            for (const item of batchItems) {
              item.status = "uploading";
              item.progress = 0;
              renderGallery();
              try {
                if (!item.file) continue;
                const result = await uploadR2File("gallery", item.file, item.id, (value) => { item.progress = value; renderGallery(); });
                item.remoteUrl = result.publicUrl;
                item.objectKey = result.key;
                item.status = "uploaded";
                item.source = item.remoteUrl;
                delete item.file;
              } catch {
                item.status = "error";
              }
              renderGalleryUploadSummary();
              renderGallery();
              scheduleSave();
            }
          } finally {
            renderGallery();
            scheduleSave();
            renderGalleryUploadSummary(true);
            updateMediaStatus();
          }
        });
        requiredElement("#upload-cover-r2").addEventListener("click", async () => { if (!selectedPhoto || !isR2Image(selectedPhoto) || selectedPhoto.size > r2ImageLimit) return showToast("Elegí una imagen JPG, PNG o WEBP dentro del tamaño permitido."); try { requiredElement("#cover-upload-progress").textContent = "Subiendo foto…"; const result = await uploadR2File("cover", selectedPhoto, "", (value) => requiredElement("#cover-upload-progress").textContent = "Subiendo foto… " + value + "%"); remoteCover = { url: result.publicUrl, objectKey: result.key, contentType: selectedPhoto.type }; requiredElement("#cover-upload-progress").textContent = "✓ Subida"; updateMediaStatus(); scheduleSave(); } catch { requiredElement("#cover-upload-progress").textContent = "⚠ No se pudo subir la foto."; } });
        requiredElement("#upload-video-r2").addEventListener("click", async () => { if (!selectedVideo || !isMp4File(selectedVideo) || selectedVideo.size > r2VideoLimit) return showToast("Elegí un video MP4 dentro del tamaño permitido."); try { requiredElement("#video-upload-progress").textContent = "Subiendo video…"; const result = await uploadR2File("video", selectedVideo, "", (value) => requiredElement("#video-upload-progress").textContent = "Subiendo video… " + value + "%"); remoteVideo = { url: result.publicUrl, objectKey: result.key, contentType: selectedVideo.type }; requiredElement("#video-upload-progress").textContent = "✓ Subido"; updateMediaStatus(); scheduleSave(); } catch { requiredElement("#video-upload-progress").textContent = "⚠ No se pudo subir el video."; } });
        r2Notice();
        requiredElement("#confirm-publication").addEventListener("click", markPublished);
        const closePublicationConfirmButton = requiredElement<HTMLButtonElement>("#close-publication-confirm");
        const cancelPublicationConfirmButton = requiredElement<HTMLButtonElement>("#cancel-publication-confirm");
        if (publicationConfirmDialog) {
          [closePublicationConfirmButton, cancelPublicationConfirmButton]
            .filter((button): button is HTMLButtonElement => Boolean(button))
            .forEach((button) => button.addEventListener("click", () => {
              if (publicationConfirmDialog.open) publicationConfirmDialog.close();
            }));
        }

        const confirmPresentationImageButton = requiredElement<HTMLButtonElement>("#confirm-presentation-image");
        const closePresentationImageButton = requiredElement<HTMLButtonElement>("#close-presentation-image-dialog");
        const cancelPresentationImageButton = requiredElement<HTMLButtonElement>("#cancel-presentation-image");
        if (presentationImageDialog) {
          confirmPresentationImageButton?.addEventListener("click", () => {
            if (!selectingPresentationImage || !pendingPresentationImageId) { showToast("Elegí una imagen primero."); return; }
            presentationImages[selectingPresentationImage] = pendingPresentationImageId;
            if (selectingPresentationImage === "cover") selectedFutureCoverId = pendingPresentationImageId;
            presentationImageDialog.close(); renderGallery(); saveDraft();
          });
          [closePresentationImageButton, cancelPresentationImageButton]
            .filter((button): button is HTMLButtonElement => Boolean(button))
            .forEach((button) => button.addEventListener("click", () => presentationImageDialog.close()));
        }
        if (galleryInput) {
          gallerySelect?.addEventListener("click", (event) => { event.stopPropagation(); galleryInput.click(); });
          galleryInput.addEventListener("change", () => {
            if (galleryInput.files) addTemporaryGalleryFiles(Array.from(galleryInput.files));
            galleryInput.value = "";
          });
        }
        if (galleryDropzone && galleryInput) {
          galleryDropzone.addEventListener("click", () => galleryInput.click());
          ["dragenter", "dragover"].forEach((name) => galleryDropzone.addEventListener(name, (event) => { event.preventDefault(); galleryDropzone.classList.add("dragging"); }));
          ["dragleave", "drop"].forEach((name) => galleryDropzone.addEventListener(name, (event) => { event.preventDefault(); galleryDropzone.classList.remove("dragging"); }));
          galleryDropzone.addEventListener("drop", (event: DragEvent) => {
            if (!event.dataTransfer) return;
            addTemporaryGalleryFiles(Array.from(event.dataTransfer.files));
          });
        }
        renderDraftCards();
      })();
    </script>
  </body>
</html>


