        requiredElement("#distances-back").addEventListener("click", () => { saveDraft(); setStep(7); });
        requiredElement("#distances-save-exit").addEventListener("click", () => { saveDraft(); showList(); showToast("Las distancias quedaron guardadas como borrador."); });
        requiredElement("#review-back").addEventListener("click", () => { saveDraft(); setStep(8); });
        requiredElement("#review-save-exit").addEventListener("click", () => { saveDraft(); showList(); showToast("La revisión quedó guardada en el borrador."); });
        requiredElement("#prepare-presentation").addEventListener("click", () => { saveDraft(); openPreparation(); });
        requiredElement("#close-preparation").addEventListener("click", closePreparation);
        requiredElement("#preparation-cancel").addEventListener("click", closePreparation);
        const preparationCoverSelect = requiredElement<HTMLButtonElement>("#preparation-cover-select");
        const preparationGallerySelect = requiredElement<HTMLButtonElement>("#preparation-gallery-select");
        const preparationVideoSelect = requiredElement<HTMLButtonElement>("#preparation-video-select");
        if (preparationCoverInput) {
