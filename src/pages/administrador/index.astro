        const setStep = (step) => {
          document.querySelectorAll(".step").forEach((item) => {
            const itemStep = Number(item.dataset.step);
            const active = itemStep === step;
            item.classList.toggle("active", active);
            item.classList.toggle("completed", itemStep < step && itemStep <= 4);
            if (active) item.setAttribute("aria-current", "step");
            else item.removeAttribute("aria-current");
          });
          stepCount.textContent = "Paso " + step + " de 9";
          form.hidden = step !== 1;
          coverForm.hidden = step !== 2;
          propertyForm.hidden = step !== 3;
          dataForm.hidden = step !== 4;
          galleryForm.hidden = step !== 5;
          featuresForm.hidden = step !== 6;
          locationForm.hidden = step !== 7;
          distancesForm.hidden = step !== 8;
          reviewStep.hidden = step !== 9;
          if (step === 9) renderReview();
        };

        const setVideoEnabled = (enabled) => {
          document.querySelector(`input[name="videoEnabled"][value="${enabled ? "yes" : "no"}"]`).checked = true;
          videoField.hidden = !enabled;
          updateMediaStatus();
        };

        const setStatus = (element, text, complete = false) => {
          element.textContent = text;
          element.classList.toggle("status-success", complete);
          element.classList.toggle("status-warning", !complete);
        };

        const updateMediaStatus = () => {
          const slug = slugify(nameInput.value) || "nueva-propiedad";
          const detected = detectedMedia[slug] || { cover: false, gallery: [], video: false };
          const usesExternalOriginal = editingId === originalProperty.id;
          const hasCover = detected.cover || usesExternalOriginal;
          const galleryCount = Math.max(detected.gallery.length, usesExternalOriginal ? 8 : 0);
          const hasVideo = detected.video || usesExternalOriginal;
          const videoRequired = document.querySelector('input[name="videoEnabled"]:checked')?.value === "yes";
          const galleryRequired = usesExternalOriginal;
          const missing = [];

          expectedFolder.textContent = `public/media/${slug}/`;
          setStatus(statusPhoto, hasCover ? "✓ Subida" : "⚠ No subida", hasCover);
          statusGallery.textContent = `${galleryCount} ${galleryCount === 1 ? "foto detectada" : "fotos detectadas"}`;
          statusGallery.classList.toggle("status-success", galleryCount > 0);
          statusGallery.classList.toggle("status-neutral", galleryCount === 0);

          if (!videoRequired) setStatus(statusVideo, "No requerido", true);
          else setStatus(statusVideo, hasVideo ? "✓ Subido" : "⚠ No subido", hasVideo);

          if (!hasCover) missing.push("portada.jpg");
          if (videoRequired && !hasVideo) missing.push("video.mp4");
          if (galleryRequired && galleryCount === 0) missing.push("al menos foto-01.jpg");

          const complete = missing.length === 0;
          setStatus(statusGeneral, complete ? "✓ Completo" : "⚠ Faltan archivos", complete);
          missingFiles.hidden = complete;
          missingFilesList.replaceChildren(...missing.map((name) => {
            const item = document.createElement("li");
            item.textContent = name;
            return item;
          }));
          externalMediaNote.hidden = !usesExternalOriginal;
