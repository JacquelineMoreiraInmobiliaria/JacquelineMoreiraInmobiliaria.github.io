          request.onload = () => request.status >= 200 && request.status < 300 ? resolve() : reject(new Error("No se pudo subir el archivo."));
          request.onerror = () => reject(new Error("No se pudo subir el archivo.")); request.send(file);
        });
        const uploadR2File = async (kind, file, id, progress) => { activeUploads++; try { const signed = await signedUpload(kind, file, id); await putFile(signed.uploadUrl, file, progress); return signed; } finally { activeUploads--; } };
        window.addEventListener("beforeunload", (event) => { if (activeUploads) { event.preventDefault(); event.returnValue = ""; } });

        const renderGallery = () => {
