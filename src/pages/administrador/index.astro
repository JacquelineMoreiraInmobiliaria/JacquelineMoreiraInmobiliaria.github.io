          const draft = pendingDelete;
          if (!draft) return;
          const remote = hasRemoteMedia(draft);
          if (remote && deleteConfirmationStage === 1) {
            deleteConfirmationStage = 2;
            deletePropertyMessage.textContent = "Esta propiedad tiene multimedia guardada. Confirmá nuevamente para eliminar definitivamente sus fotos y videos.";
            confirmDeleteProperty.textContent = "Sí, eliminar definitivamente";
            return;
          }
          confirmDeleteProperty.disabled = true;
          confirmDeleteProperty.textContent = "Eliminando…";
          try {
            if (remote) {
              if (!r2Configured) throw new Error("delete-unavailable");
              await deleteRemotePropertyMedia(draft.slug);
            }
            finishLocalDeletion(draft);
          } catch {
            confirmDeleteProperty.disabled = false;
            confirmDeleteProperty.textContent = "Reintentar eliminación";
            showToast("No se pudieron eliminar todos los archivos. La propiedad no fue eliminada del administrador.");
          }
        });
        requiredElement("#close-delete-property").addEventListener("click", closeDeleteProperty);
        requiredElement("#cancel-delete-property").addEventListener("click", closeDeleteProperty);
