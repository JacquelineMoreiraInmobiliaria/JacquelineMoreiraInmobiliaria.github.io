            draftThumb.textContent = "Sin portada";
          }
          requiredElement(".draft-subtitle", card).textContent = draft.subtitle || "Subtítulo sin completar";
          requiredElement(".property-price", card).textContent = draft.price || "Precio sin completar";
          const cardState = publicationCardState(draft, false, isPublished);
          const badge = requiredElement<HTMLElement>(".publication-badge", card);
          badge.textContent = cardState.label;
          badge.className = "publication-badge " + cardState.className;
          const publicationLink = requiredElement<HTMLAnchorElement>("[data-publication-link]", card);
          if (isPublished) {
            publicationLink.href = "/propiedades/" + draft.slug + "/";
            publicationLink.hidden = false;
          }
          const localDraft = findDraftBySlug(readDrafts(), draft.slug);
          const deleteButton = requiredElement<HTMLButtonElement>("[data-delete-draft]", card);
          deleteButton.hidden = !localDraft;
          requiredElement<HTMLButtonElement>("[data-edit-draft]", card).addEventListener("click", () => {
            const drafts = readDrafts();
            const existing = findDraftBySlug(drafts, draft.slug);
            const editable = existing || draft;
            if (!existing && isPublished) {
              drafts[editable.id] = editable;
              writeDrafts(drafts);
            }
            openEditor("edit", editable);
          });
          deleteButton.addEventListener("click", () => {
            const latest = findDraftBySlug(readDrafts(), draft.slug);
            if (latest) openDeleteProperty(latest);
          });
          requiredElement("#property-cards").appendChild(card);
