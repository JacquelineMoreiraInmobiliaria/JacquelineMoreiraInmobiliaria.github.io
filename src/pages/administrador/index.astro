          const response = await fetch(r2Config.workerUrl.replace(/\/$/, "") + "/property-media", {
            method: "DELETE",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ slug })
          });
          if (!response.ok) throw new Error("delete-failed");
          return response.json();
        };
