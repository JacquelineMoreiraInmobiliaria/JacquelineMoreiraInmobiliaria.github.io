            card.querySelector("[data-remove]").textContent = "Quitar de la galería"; card.querySelector("[data-remove]").addEventListener("click", () => { galleryItems = galleryItems.filter((entry) => entry !== item); if (selectedFutureCoverId === item.id) selectedFutureCoverId = null; renderGallery(); scheduleSave(); });
            card.addEventListener("dragstart", () => { draggedGalleryItem = item; card.classList.add("dragging"); });
