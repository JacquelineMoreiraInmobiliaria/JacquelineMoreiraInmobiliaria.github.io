            card.addEventListener("dragover", (event) => { event.preventDefault(); if (!draggedGalleryItem || draggedGalleryItem === item) return; const from = galleryItems.indexOf(draggedGalleryItem); const to = galleryItems.indexOf(item); galleryItems.splice(from, 1); galleryItems.splice(to, 0, draggedGalleryItem); renderGallery(); });
            return card;
