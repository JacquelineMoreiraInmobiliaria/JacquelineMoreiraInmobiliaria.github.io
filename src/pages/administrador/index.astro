---
import type { Dirent } from "node:fs";
import { readdir } from "node:fs/promises";
import { join } from "node:path";
import { getCollection } from "astro:content";

type MediaInventoryItem = {
  cover: boolean;
  gallery: string[];
  video: boolean;
};
type MediaInventory = Record<string, MediaInventoryItem>;
type PublishedPropertyMedia = Record<string, {
  cover: string;
  gallery: Array<{ source: string; visible: boolean }>;
  video: string;
}>;
type PresentationImageTarget = "cover" | "property" | "features" | "distances" | "final";
type PresentationImages = Record<PresentationImageTarget, string | null>;
const presentationImageTargets: PresentationImageTarget[] = ["cover", "property", "features", "distances", "final"];

const propertyPreviewUrl = "/propiedades/atardecer-y-vides/";
const mediaRoot = join(process.cwd(), "public", "media");
const mediaDirectories: Dirent[] = await readdir(mediaRoot, { withFileTypes: true }).catch((): Dirent[] => []);
const propertiesRoot = join(process.cwd(), "src", "data", "properties");
const propertyFiles: string[] = await readdir(propertiesRoot).catch((): string[] => []);
const publishedSlugs: string[] = propertyFiles
  .filter((name) => /\.ya?ml$/i.test(name))
  .map((name) => name.replace(/\.ya?ml$/i, ""));
const publishedEntries = await getCollection("properties");
const publishedPropertyMedia: PublishedPropertyMedia = Object.fromEntries(publishedEntries.map((entry) => [
  entry.data.slug,
  {
    cover: entry.data.hero.coverImage,
    gallery: entry.data.gallery.images.map((image) => ({ source: image.source, visible: image.visible })),
    video: entry.data.hero.video.source || ""
  }
]));
const publishedPropertyInventory = Object.fromEntries(publishedEntries.map((entry) => [
  entry.data.slug,
  { ...entry.data, yamlPath: "src/data/properties/" + entry.data.slug + ".yaml" }
]));
const mediaInventory: MediaInventory = Object.fromEntries(await Promise.all(
  mediaDirectories
    .filter((entry) => entry.isDirectory())
    .map(async (entry): Promise<[string, MediaInventoryItem]> => {
      const files: string[] = await readdir(join(mediaRoot, entry.name)).catch((): string[] => []);
      const gallery = files
        .filter((name) => /^foto-(\d+)\.jpg$/i.test(name))
        .sort((a, b) => Number(a.match(/\d+/)?.[0]) - Number(b.match(/\d+/)?.[0]));
      return [entry.name, {
        cover: files.some((name) => name.toLowerCase() === "portada.jpg"),
        gallery,
        video: files.some((name) => name.toLowerCase() === "video.mp4")
      }];
    })
));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Administrador guiado de presentaciones de propiedades" />
    <title>Presentaciones de propiedades | Moreira Inmobiliaria</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/admin.css" />
  </head>
  <body>
    <header class="admin-header">
      <a class="admin-brand" href="/administrador/" aria-label="Volver a Presentaciones de propiedades">
        <img src="https://raw.githubusercontent.com/JacquelineMoreiraInmobiliaria/atardecer-y-vides/main/fotos/logo.png" alt="Moreira Inmobiliaria" />
      </a>
      <span class="admin-label">Administrador</span>
    </header>

    <main>
      <section id="property-list" class="screen" aria-labelledby="list-title">
        <div class="page-heading">
          <div>
            <p class="eyebrow">Moreira Inmobiliaria</p>
            <h1 id="list-title">Presentaciones de propiedades</h1>
            <p class="intro">Creá y editá las presentaciones de tus propiedades desde un formulario simple.</p>
          </div>
          <button id="new-property" class="button button-primary" type="button">+ Nueva propiedad</button>
        </div>

        <div id="property-cards" class="property-grid">
          <article class="property-card" data-card="atardecer-y-vides">
            <div class="property-thumb">
              <img src="https://raw.githubusercontent.com/JacquelineMoreiraInmobiliaria/atardecer-y-vides/main/fotos/hero.jpg" alt="" />
            </div>
            <div class="property-content">
              <div>
                <h2 data-card-name>Atardecer y Vides</h2>
                <p data-card-subtitle>Piriápolis · Maldonado</p>
                <p class="property-price" data-card-price>USD 850.000</p>
              </div>
              <div class="card-actions">
                <button class="button button-secondary" type="button" data-edit="atardecer-y-vides">Editar</button>
                <button class="button button-quiet" type="button" data-duplicate>Duplicar</button>
                <a class="button button-quiet" href={propertyPreviewUrl} target="_blank" rel="noopener">Vista previa</a>
              </div>
              <p class="protected-property-note">Propiedad de referencia protegida</p>
            </div>
          </article>
        </div>
      </section>

      <section id="editor" class="screen editor-screen" aria-labelledby="editor-title" hidden>
        <div class="editor-heading">
          <div>
            <p id="step-count" class="eyebrow">Paso 1 de 9</p>
            <h1 id="editor-title">Nueva propiedad</h1>
            <p id="editor-intro" class="intro">Completá la información básica para empezar.</p>
          </div>
          <p id="save-state" class="save-state" aria-live="polite">Los cambios se guardan automáticamente</p>
        </div>

        <nav class="steps" aria-label="Pasos del formulario">
          <button class="step active" type="button" data-step="1" aria-current="step"><span>1</span>Información</button>
          <button class="step" type="button" data-step="2"><span>2</span>Portada</button>
          <button class="step" type="button" data-step="3"><span>3</span>Propiedad</button>
          <button class="step" type="button" data-step="4"><span>4</span>Datos</button>
          <button class="step" type="button" data-step="5"><span>5</span>Galería</button>
          <button class="step" type="button" data-step="6"><span>6</span>Características</button>
          <button class="step" type="button" data-step="7"><span>7</span>Ubicación</button>
          <button class="step" type="button" data-step="8"><span>8</span>Distancias</button>
          <button class="step" type="button" data-step="9"><span>9</span>Revisión</button>
        </nav>

        <div class="form-shell">
          <form id="basic-form" novalidate>
            <div class="form-heading">
              <p class="eyebrow">Información básica</p>
              <h2>Empecemos por identificar la propiedad</h2>
              <p>Después vas a poder completar las fotografías, características y ubicación.</p>
            </div>

            <div class="field">
              <label for="property-name">Nombre de la propiedad <span aria-hidden="true">*</span></label>
              <input id="property-name" name="name" type="text" autocomplete="off" required placeholder="Escribir nombre" aria-describedby="name-example name-error" />
              <p id="name-example" class="example">Ejemplo: Atardecer y Vides</p>
              <p id="name-error" class="field-error" aria-live="polite"></p>
            </div>

            <div class="field">
              <label for="property-price">Precio <small>Opcional</small></label>
              <input id="property-price" name="price" type="text" autocomplete="off" placeholder="Escribir precio" aria-describedby="price-example" />
              <p id="price-example" class="example">Ejemplo: USD 850.000</p>
            </div>

            <p class="field-help">El subtítulo se generará automáticamente desde el nombre visible de la ubicación.</p>

            <div class="form-actions">
              <button id="cancel" class="button button-quiet" type="button">Cancelar</button>
              <button id="save-exit" class="button button-secondary" type="button">Guardar y salir</button>
              <button class="button button-primary" type="submit">Siguiente</button>
            </div>
          </form>

          <form id="cover-form" novalidate hidden>
            <div class="form-heading">
              <p class="eyebrow">Portada</p>
              <h2>Elegí la primera impresión</h2>
              <p>Definí el texto y el contenido visual que recibirán a quien visite la presentación.</p>
            </div>

            <section id="media-summary" class="repository-media" aria-labelledby="property-files-title">
              <div id="legacy-media-folder">
              <div class="repository-heading">
                <div>
                  <p class="eyebrow">Archivos de esta propiedad</p>
                  <h3 id="property-files-title">Carpeta esperada</h3>
                </div>
                <code id="expected-folder">public/media/nueva-propiedad/</code>
              </div>
              <p class="field-help">Subí las fotos y el video de esta propiedad dentro de esta carpeta en GitHub.</p>
              </div>
              <div class="media-status" aria-labelledby="media-status-title">
                <h3 id="media-status-title">Multimedia</h3>
                <dl>
                  <div><dt>Foto principal</dt><dd id="status-photo" class="status-warning">⚠ No subida</dd></div>
                  <div><dt>Galería</dt><dd id="status-gallery">0 fotos detectadas</dd></div>
                  <div><dt>Video</dt><dd id="status-video">No requerido</dd></div>
                  <div class="general-status"><dt>Estado general</dt><dd id="status-general" class="status-warning">Faltan archivos</dd></div>
                </dl>
                <div id="missing-files" class="missing-files">
                  <strong>Falta:</strong>
                  <ul id="missing-files-list"><li>portada.jpg</li></ul>
                </div>
                <p id="external-media-note" class="external-note" hidden>Esta propiedad utiliza temporalmente los archivos disponibles en su presentación actual.</p>
              </div>
            </section>

            <div class="field">
              <label for="cover-description">Descripción corta de portada <small>Opcional</small></label>
              <p class="field-help">Es el texto breve que aparecerá sobre la imagen o video principal.</p>
              <textarea id="cover-description" name="coverDescription" rows="5" placeholder="Escribir descripción" aria-describedby="cover-description-example"></textarea>
              <p id="cover-description-example" class="example">Ejemplo: 10 hectáreas de privacidad, naturaleza y una imponente vista panorámica de 180° sobre el mar.</p>
            </div>

            <fieldset class="media-field">
              <legend>Foto principal <span aria-hidden="true">*</span></legend>
              <p class="field-help">Esta será la imagen principal de la presentación. Más adelante también podrás elegir una foto de la galería como portada.</p>
              <input id="cover-photo-input" class="visually-hidden" type="file" accept="image/*" />
              <div id="photo-dropzone" class="dropzone" tabindex="0" role="button" aria-describedby="photo-help photo-error">
                <div id="photo-empty">
                  <div class="upload-icon" aria-hidden="true">↑</div>
                  <strong>Arrastrá una imagen hasta aquí</strong>
                  <span>o</span>
                  <button id="select-photo" class="button button-secondary" type="button">Seleccionar foto</button>
                </div>
                <div id="photo-preview" class="media-preview" hidden>
                  <img id="photo-preview-image" src="" alt="Vista previa de la foto principal" />
                  <div class="media-info">
                    <strong id="photo-name"></strong>
                    <span>Foto principal seleccionada</span>
                    <div class="media-actions">
                      <button id="change-photo" class="button button-quiet" type="button">Cambiar foto</button>
                      <button id="remove-photo" class="button button-danger" type="button">Eliminar</button>
                    </div>
                  </div>
                </div>
              </div>
              <p id="photo-help" class="example">Podés elegir una imagen directamente desde tu computadora o teléfono.</p>
              <p id="r2-cover-note" class="temporary-help">La carga directa todavía no está configurada. Podés continuar con el flujo manual actual.</p><button id="upload-cover-r2" class="button button-secondary" type="button" hidden>Subir foto</button><p id="cover-upload-progress" class="field-help" aria-live="polite"></p><p class="temporary-help">Esta selección sirve para preparar la propiedad. La publicación definitiva del archivo se hará cuando esté cargado en la carpeta indicada.</p>
              <p id="photo-error" class="field-error" aria-live="polite"></p>
            </fieldset>

            <fieldset class="choice-field">
              <legend>¿Mostrar video en la portada?</legend>
              <div class="choice-grid">
                <label class="choice-card">
                  <input type="radio" name="videoEnabled" value="yes" />
                  <span>Sí</span>
                </label>
                <label class="choice-card">
                  <input type="radio" name="videoEnabled" value="no" checked />
                  <span>No</span>
                </label>
              </div>
            </fieldset>

            <div id="video-field" class="media-field" hidden>
              <div class="field-label">Video MP4</div>
              <p class="field-help">Si agregás un video, se utilizará como fondo de la portada. Si no hay video, se mostrará la foto principal.</p>
              <input id="cover-video-input" class="visually-hidden" type="file" accept="video/mp4,.mp4" />
              <div id="video-empty" class="file-picker">
                <button id="select-video" class="button button-secondary" type="button">Seleccionar video</button>
                <span>Únicamente archivos MP4</span>
              </div>
              <div id="video-selected" class="selected-file" hidden>
                <div class="file-icon" aria-hidden="true">▶</div>
                <div>
                  <strong id="video-name"></strong>
                  <span>Video seleccionado</span>
                </div>
                <div class="media-actions">
                  <button id="change-video" class="button button-quiet" type="button">Cambiar video</button>
                  <button id="remove-video" class="button button-danger" type="button">Eliminar</button>
                </div>
              </div>
              <p id="video-error" class="field-error" aria-live="polite"></p>
              <button id="upload-video-r2" class="button button-secondary" type="button" hidden>Subir video</button><p id="video-upload-progress" class="field-help" aria-live="polite"></p><p class="temporary-help">Esta selección es temporal y no significa que el video ya esté subido.</p>
            </div>

            <div class="form-actions">
              <button id="cover-back" class="button button-quiet" type="button">Atrás</button>
              <button id="cover-save-exit" class="button button-secondary" type="button">Guardar y salir</button>
              <button class="button button-primary" type="submit">Siguiente</button>
            </div>
          </form>

          <form id="property-form" novalidate hidden>
            <div class="form-heading">
              <p class="eyebrow">La propiedad</p>
              <h2>Contá todo sobre la propiedad</h2>
              <p>Podés pegar o escribir toda la información en un solo lugar.</p>
            </div>
            <div class="field">
              <label for="property-description">Descripción completa de la propiedad <small>Opcional</small></label>
              <p class="field-help">Pegá o escribí aquí toda la información de la propiedad. Más adelante el sistema la organizará en una presentación clara.</p>
              <textarea id="property-description" name="propertyDescription" rows="14" placeholder="Escribir descripción completa"></textarea>
              <p class="example">Ejemplo: Propiedad ubicada en la zona alta de Piriápolis, sobre 10 hectáreas, con vista al mar, piscina climatizada, cuatro dormitorios, tres baños, losa radiante y viñedo.</p>
              <p class="field-help">Podés separar ideas con saltos de línea. El texto original siempre se conserva.</p>
            </div>
            <section class="chatgpt-workflow" aria-labelledby="chatgpt-workflow-title">
              <div class="chatgpt-workflow-heading">
                <p class="eyebrow">Organizar con ChatGPT</p>
                <h3 id="chatgpt-workflow-title">Convertí el texto en una propuesta ordenada</h3>
                <p>Esta opción no usa ninguna API paga. Copiá el mensaje, pegalo en ChatGPT y luego pegá aquí la respuesta.</p>
              </div>
              <ol class="chatgpt-steps">
                <li>
                  <span>1</span>
                  <div><strong>Copiar mensaje</strong><p>Preparamos las instrucciones junto con la descripción de esta propiedad.</p><button id="copy-chatgpt-prompt" class="button button-secondary" type="button">Copiar mensaje para ChatGPT</button><p id="copy-chatgpt-note" class="field-help" aria-live="polite"></p></div>
                </li>
                <li>
                  <span>2</span>
                  <div><strong>Organizar en ChatGPT</strong><p>Pegá el mensaje en ChatGPT y esperá la respuesta completa. No es necesario abrirlo automáticamente desde aquí.</p></div>
                </li>
                <li>
                  <span>3</span>
                  <div class="chatgpt-paste"><label for="chatgpt-response">Pegar respuesta de ChatGPT</label><textarea id="chatgpt-response" rows="10" placeholder='Pegá aquí la respuesta que comienza con { y termina con }'></textarea><button id="apply-chatgpt-response" class="button button-primary" type="button">Aplicar organización</button><p id="chatgpt-response-error" class="field-error" aria-live="polite"></p></div>
                </li>
              </ol>
              <p class="temporary-help">Este método no utiliza una API paga. Usa ChatGPT manualmente.</p>
            </section>
            <section id="organized-description" class="gallery-order-section" hidden aria-labelledby="organized-description-title">
              <div class="paragraphs-heading"><div><h3 id="organized-description-title">Vista organizada</h3><p>Podés corregir libremente el título y los párrafos antes de guardar.</p></div></div>
              <div class="field"><label for="organized-headline">Título destacado <small>Opcional</small></label><input id="organized-headline" type="text" placeholder="Escribir título destacado" /><p class="field-help">Podés editar libremente el título propuesto.</p></div>
              <div id="organized-paragraphs" class="feature-list"></div>
              <button id="add-organized-paragraph" class="button button-secondary" type="button">+ Agregar párrafo</button>
              <section id="ai-suggestions" class="repository-media" hidden>
                <div class="suggestion-section">
                  <div class="paragraphs-heading"><div><h3>Sugerencias de datos destacados</h3><p>La IA solamente propone. Elegí qué querés agregar al Paso 4.</p></div><button id="add-all-summary-suggestions" class="button button-quiet" type="button">Agregar todas</button></div>
                  <div id="summary-suggestions" class="suggestion-list"></div>
                </div>
                <div class="suggestion-section">
                  <div class="paragraphs-heading"><div><h3>Sugerencias de características</h3><p>Elegí qué querés agregar al Paso 6.</p></div><button id="add-all-feature-suggestions" class="button button-quiet" type="button">Agregar todas</button></div>
                  <div id="feature-suggestions" class="suggestion-list"></div>
                </div>
              </section>
            </section>
            <div class="form-actions">
              <button id="property-back" class="button button-quiet" type="button">Atrás</button>
              <button id="property-save-exit" class="button button-secondary" type="button">Guardar y salir</button>
              <button class="button button-primary" type="submit">Siguiente</button>
            </div>
          </form>
          <form id="data-form" novalidate hidden>
            <div class="form-heading">
              <p class="eyebrow">Datos destacados</p>
              <h2>Resumí lo más importante</h2>
              <p>Agregá todos los datos que necesites y ordenalos como querés que aparezcan.</p>
            </div>

            <div class="data-toolbar">
              <div>
                <h3>Datos de la propiedad</h3>
                <p>Los datos incompletos o marcados como “No” se conservarán en el borrador, pero no aparecerán en la futura presentación.</p>
              </div>
              <button id="add-featured-data" class="button button-secondary" type="button">+ Agregar dato</button>
            </div>

            <div id="featured-data-list" class="featured-data-list"></div>

            <div class="form-actions">
              <button id="data-back" class="button button-quiet" type="button">Atrás</button>
              <button id="data-save-exit" class="button button-secondary" type="button">Guardar y salir</button>
              <button class="button button-primary" type="submit">Siguiente</button>
            </div>
          </form>

          <form id="gallery-form" novalidate hidden>
            <div class="form-heading">
              <p class="eyebrow">Galería</p>
              <h2>Prepará las fotos de la propiedad</h2>
              <p id="gallery-form-intro">Seleccioná las fotos, subilas y ordenalas como querés que aparezcan en la presentación.</p>
            </div>
            <fieldset class="choice-field">
              <legend>¿Mostrar galería en la presentación?</legend>
              <div class="choice-grid">
                <label class="choice-card"><input type="radio" name="galleryEnabled" value="yes" /><span>Sí</span></label>
                <label class="choice-card"><input type="radio" name="galleryEnabled" value="no" /><span>No</span></label>
              </div>
              <p class="field-help">Si elegís No, la sección de galería no aparecerá en la presentación.</p>
              <p id="gallery-hidden-note" class="temporary-help" hidden>La configuración y las fotos se conservan en este borrador, pero la galería no aparecerá.</p>
            </fieldset>
            <div id="gallery-controls">
              <section id="legacy-gallery-media" class="repository-media" aria-labelledby="gallery-files-title">
                <div class="repository-heading"><div><p class="eyebrow">Archivos de esta propiedad</p><h3 id="gallery-files-title">Carpeta de esta propiedad</h3></div><code id="gallery-folder">public/media/nueva-propiedad/</code></div>
                <p class="field-help">Fotos detectadas en GitHub: <strong id="gallery-detected-count">0</strong>. La detección ocurre durante el build: para actualizar este estado es necesario generar una nueva preview.</p>
                <p id="original-gallery-note" class="external-note" hidden>Galería actual disponible desde la presentación original.</p>
                <p id="gallery-empty-note" class="missing-files">Todavía no hay fotos de galería subidas.</p>
                <div id="gallery-detected-list" class="detected-file-list"></div>
              </section>
              <section class="gallery-preparation" aria-labelledby="gallery-preparation-title">
                <div class="paragraphs-heading"><div><h3 id="gallery-preparation-title">Preparar nuevas fotos</h3><p>Podés seleccionar varias imágenes o arrastrarlas. El orden que ves aquí será el orden de la galería.</p></div></div>
                <input id="gallery-input" class="visually-hidden" type="file" accept="image/*" multiple />
                <div id="gallery-dropzone" class="gallery-dropzone" tabindex="0" role="button"><div class="upload-icon" aria-hidden="true">↑</div><strong>Arrastrá fotos hasta aquí</strong><span>o</span><button id="gallery-select" class="button button-secondary" type="button">Seleccionar fotos</button></div>
                <p id="r2-gallery-note" class="temporary-help">La carga directa todavía no está configurada.</p><button id="upload-gallery-r2" class="button button-secondary" type="button" hidden>Subir fotos seleccionadas</button><p id="gallery-upload-progress" class="field-help empty-placeholder" aria-live="polite"></p><p id="gallery-selection-help" class="temporary-help">Las fotos seleccionadas todavía no están subidas.</p>
              </section>
              <section class="gallery-order-section" aria-labelledby="gallery-order-title">
                <div class="paragraphs-heading"><div><h3 id="gallery-order-title">Orden de galería</h3><p>Arrastrá las fotos o usá Subir y Bajar. La persona no necesita decidir los nombres internos.</p></div></div>
                <p class="field-help">Foto principal actual: <strong id="gallery-cover-name">portada.jpg</strong> <span id="gallery-cover-status"></span></p><p class="temporary-help">Recomendado: entre 10 y 15 fotos para mantener una presentación ágil y fácil de recorrer.</p><p id="gallery-recommendation" class="field-help" aria-live="polite"></p>
                <div id="gallery-list" class="gallery-editor-list"></div>
                <p id="gallery-warning" class="missing-files" hidden>Todavía no hay fotos de galería subidas.</p>
              </section>
              <section class="gallery-order-section" aria-labelledby="presentation-images-title">
                <div class="paragraphs-heading"><div><h3 id="presentation-images-title">Imágenes de la presentación</h3><p>Elegí fotos ya disponibles. Una misma imagen puede reutilizarse sin volver a subirla.</p></div></div>
                <div id="presentation-image-cards" class="gallery-editor-list"></div>
              </section>
            </div>
            <div class="form-actions">
              <button id="gallery-back" class="button button-quiet" type="button">Atrás</button>
              <button id="gallery-save-exit" class="button button-secondary" type="button">Guardar y salir</button>
