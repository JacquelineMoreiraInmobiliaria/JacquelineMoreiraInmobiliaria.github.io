          galleryEnabled: document.querySelector('input[name="galleryEnabled"]:checked')?.value !== "no",
          galleryItems: galleryItems.map((item, index) => ({ id: item.id, name: item.name, originalName: item.originalName, status: item.status === "temporary" ? "missing" : item.status, external: Boolean(item.external), description: item.description || "", remoteUrl: item.remoteUrl || "", objectKey: item.objectKey || "", position: index + 1 })),
