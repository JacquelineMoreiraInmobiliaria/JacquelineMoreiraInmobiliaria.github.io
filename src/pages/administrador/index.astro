                <button class="button button-danger" type="button" data-delete-draft hidden>Eliminar</button>
              </div>
            </div>`;
          requiredElement("h2", card).textContent = draft.name;
          const draftMedia = resolvePropertyMediaState(draft, detectedMedia[draft.slug] || { cover: false, gallery: [], video: false });
          const draftThumb = requiredElement<HTMLElement>(".draft-thumb", card);
          if (draftMedia.coverSource) {
            const image = document.createElement("img");
