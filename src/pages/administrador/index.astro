        const finishLocalDeletion = (draft: StoredProperty) => {
          const drafts = readDrafts();
          delete drafts[draft.id];
          writeDrafts(drafts);
          sessionMedia.delete(draft.id);
          removePublishingChecklist(draft);
          closeDeleteProperty();
          renderDraftCards();
          const publishedNotice = publishedProperties.has(draft.slug)
            ? " Los archivos multimedia fueron eliminados. Esta propiedad también tiene datos publicados en GitHub y deberán retirarse del repositorio para eliminar su presentación pública."
            : "";
