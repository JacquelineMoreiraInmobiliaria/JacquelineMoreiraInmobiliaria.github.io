        const renderDraftCards = () => {
          const drafts = readDrafts();
          const edited = findDraftBySlug(drafts, originalProperty.slug);
          const originalCard = document.querySelector('[data-card="atardecer-y-vides"]');
          if (originalCard && !originalCard.querySelector(".publication-badge")) {
            const badge = document.createElement("span");
