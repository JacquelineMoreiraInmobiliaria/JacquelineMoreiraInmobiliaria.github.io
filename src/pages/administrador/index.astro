          const checklist = readPublishingChecklist()[slug] || {};
          publicationPropertyName.textContent = values.name || "Propiedad sin nombre";
          const mediaDestination = usesR2 ? '<div><p class="eyebrow">Multimedia</p><h3>Ya está subida directamente</h3><p>No hace falta subir fotos ni video a GitHub.</p></div>' : '<div><p class="eyebrow">Multimedia</p><h3>Subí las fotos y el video aquí</h3><code class="publication-path">' + mediaPath + '</code><button type="button" data-copy="' + mediaPath + '">Copiar ruta</button></div>';
          const packageContents = usesR2 ? '<strong>' + escapeReview(yamlName) + '</strong>.' : '<strong>' + escapeReview(yamlName) + '</strong> y la carpeta <strong>media</strong>.';
          const mediaStep = usesR2 ? 'La multimedia ya está disponible; solo falta subir el archivo de datos.' : 'Subí el contenido de <strong>media</strong> a <code>' + mediaPath + '</code>.';
          publicationGuide.innerHTML = '<section class="publication-destinations"><div><p class="eyebrow">Archivo de datos</p><h3>Subí <code>' + escapeReview(yamlName) + '</code> aquí</h3><code class="publication-path">' + dataPath + '</code><button type="button" data-copy="' + dataPath + '">Copiar ruta</button></div>' + mediaDestination + '</section><section class="publication-steps"><h3>Pasos para publicar manualmente</h3><ol><li>Descomprimí <strong>' + escapeReview(slug) + '-presentacion.zip</strong>.</li><li>Dentro vas a encontrar ' + packageContents + '</li><li>En GitHub abrí el repositorio <strong>JacquelineMoreiraInmobiliaria/JacquelineMoreiraInmobiliaria.github.io</strong>.</li><li>Confirmá que estás en la rama <strong>setup-template-foundation</strong>.<span class="publication-warning">No subas estos archivos a main.</span></li><li>Subí <strong>' + escapeReview(yamlName) + '</strong> a <code>' + dataPath + '</code>.</li><li>' + mediaStep + '</li><li>Después de subirlos, GitHub iniciará automáticamente una nueva vista previa. Esperá unos minutos.</li><li>Abrí la presentación para verificarla.</li></ol></section><section class="publication-preview"><h3>Vista previa esperada</h3><a href="' + previewUrlFor(slug) + '" target="_blank" rel="noreferrer">' + previewUrlFor(slug) + '</a><p>Si todavía no abre, esperá a que termine el nuevo build de GitHub Pages.</p><button id="recheck-preview" class="button button-secondary" type="button">Volver a comprobar</button></section>';
          const checklistItems = [
            ["unzip", "Descomprimí el ZIP"],
            ["data", "Subí el archivo de la propiedad a src/data/properties/"],
            ["media", usesR2 ? "La multimedia ya está subida directamente" : "Subí las fotos/video a public/media/" + slug + "/"],
            ["branch", "Confirmé que estoy en setup-template-foundation"],
            ["build", "Esperé el nuevo build"],
            ["preview", "Abrí la vista previa"]
          ];
          publicationChecklist.replaceChildren(...checklistItems.map(([key, label]) => {
            const labelElement = document.createElement("label");
            labelElement.innerHTML = '<input type="checkbox" /> <span>' + escapeReview(label) + '</span>';
            const input = labelElement.querySelector("input");
            input.checked = Boolean(checklist[key]);
            input.addEventListener("change", () => {
              const all = readPublishingChecklist();
              all[slug] = { ...(all[slug] || {}), [key]: input.checked };
              writePublishingChecklist(all);
            });
            return labelElement;
          }));
          publicationGuide.querySelectorAll("[data-copy]").forEach((button) => button.addEventListener("click", () => copyPublicationPath(button.dataset.copy)));
          publicationGuide.querySelector("#recheck-preview").addEventListener("click", openExpectedPreview);
        };
        const openPublicationGuide = () => {
          renderPublicationGuide();
          publicationDialog.showModal();
        };
        const closePublicationGuide = () => { if (publicationDialog.open) publicationDialog.close(); };

        const loadCoverValues = (property, propertyId = null) => {
          selectedPhoto = null;
          selectedVideo = null;
          photoRemoved = false;
          videoRemoved = false;
          photoObjectUrl = null;
          const session = propertyId ? sessionMedia.get(propertyId) : null;
          coverDescription.value = property.coverDescription || "";
          if (session?.photo && session.photoUrl) {
            selectedPhoto = session.photo;
            photoObjectUrl = session.photoUrl;
            showPhoto(session.photoUrl, session.photo.name);
          } else if (property.coverPhotoSource) showPhoto(property.coverPhotoSource, property.coverPhotoName || "Foto principal");
          else {
            photoPreview.hidden = true;
            photoEmpty.hidden = false;
            photoName.textContent = "";
            photoDropzone.classList.remove("has-file");
          }
          setVideoEnabled(Boolean(property.videoEnabled));
          if (session?.video) {
            selectedVideo = session.video;
            showVideo(session.video.name);
          } else if (property.videoEnabled && property.videoName) showVideo(property.videoName);
          else {
            videoSelected.hidden = true;
            videoEmpty.hidden = false;
            videoName.textContent = "";
          }
          updateMediaStatus();
        };

        const openEditor = (mode, property = null) => {
          listScreen.hidden = true;
          editorScreen.hidden = false;
          setStep(1);
          nameError.textContent = "";
          nameInput.removeAttribute("aria-invalid");

          if (mode === "edit") {
            const drafts = readDrafts();
            const saved = drafts[originalProperty.id] || property || originalProperty;
            editingId = originalProperty.id;
            title.textContent = "Editar propiedad";
            intro.textContent = "Revisá y actualizá la información básica.";
            nameInput.value = saved.name || "";
            priceInput.value = saved.price || "";
            legacySubtitle = saved.subtitle || "";
            loadCoverValues({ ...originalProperty, ...saved }, originalProperty.id);
            loadPropertyValues({ ...originalProperty, ...saved });
            loadFeaturedData({ ...originalProperty, ...saved });
            loadGalleryValues({ ...originalProperty, ...saved });
            loadFeatures({ ...originalProperty, ...saved });
            loadLocationValues({ ...originalProperty, ...saved });
            loadDistances({ ...originalProperty, ...saved });
          } else {
            editingId = null;
            title.textContent = "Nueva propiedad";
            intro.textContent = "Completá la información básica para empezar.";
            form.reset();
            legacySubtitle = "";
            legacySectionName = "La propiedad";
            legacyPropertyHeadline = "";
            loadCoverValues({ videoEnabled: false });
            loadPropertyValues({ propertyDescription: "", sectionName: "", propertyHeadline: "", paragraphs: [] });
            loadFeaturedData({ featuredData: [] });
            loadGalleryValues({ galleryEnabled: true, galleryItems: detectedGalleryItems() });
            loadFeatures({ features: [] });
            loadLocationValues({ locationEnabled: false });
            loadDistances({ distancesEnabled: false, distances: [] });
          }

          window.scrollTo({ top: 0, behavior: "smooth" });
          window.setTimeout(() => nameInput.focus(), 200);
        };

        const renderDraftCards = () => {
          const drafts = readDrafts();
          const edited = drafts[originalProperty.id];
          const originalCard = document.querySelector('[data-card="atardecer-y-vides"]');
          if (edited && originalCard) {
            originalCard.querySelector("[data-card-name]").textContent = edited.name || originalProperty.name;
            originalCard.querySelector("[data-card-price]").textContent = edited.price || "Precio sin completar";
            originalCard.querySelector("[data-card-subtitle]").textContent = edited.subtitle || "Subtítulo sin completar";
          }

          document.querySelectorAll("[data-draft-card]").forEach((card) => card.remove());
          Object.values(drafts).filter((draft) => draft.id !== originalProperty.id && draft.name).forEach((draft) => {
            const card = document.createElement("article");
            card.className = "property-card draft-card";
            card.dataset.draftCard = draft.id;
            card.innerHTML = `
              <div class="draft-thumb" aria-hidden="true">Sin portada</div>
              <div class="property-content">
                <div>
                  <h2></h2>
                  <p class="draft-subtitle"></p>
                  <p class="property-price"></p>
                </div>
                <div class="card-actions">
                  <button class="button button-secondary" type="button" data-edit-draft>Editar</button>
                  <button class="button button-quiet" type="button" data-duplicate>Duplicar</button>
                  <button class="button button-quiet" type="button" disabled>Vista previa</button>
                </div>
              </div>`;
            card.querySelector("h2").textContent = draft.name;
            card.querySelector(".draft-subtitle").textContent = draft.subtitle || "Subtítulo sin completar";
            card.querySelector(".property-price").textContent = draft.price || "Precio sin completar";
            card.querySelector("[data-edit-draft]").addEventListener("click", () => {
              editingId = draft.id;
              listScreen.hidden = true;
              editorScreen.hidden = false;
              title.textContent = "Editar propiedad";
              intro.textContent = "Revisá y actualizá la información básica.";
              nameInput.value = draft.name || "";
              priceInput.value = draft.price || "";
              legacySubtitle = draft.subtitle || "";
              loadCoverValues(draft, draft.id);
              loadPropertyValues(draft);
              loadFeaturedData(draft);
              loadGalleryValues(draft);
              loadFeatures(draft);
              loadLocationValues(draft);
              loadDistances(draft);
              setStep(1);
              window.scrollTo({ top: 0, behavior: "smooth" });
            });
            document.querySelector("#property-cards").appendChild(card);
          });
        };

        document.querySelector("#new-property").addEventListener("click", () => openEditor("new"));
        document.querySelector("[data-edit='atardecer-y-vides']").addEventListener("click", () => openEditor("edit", originalProperty));
        document.querySelectorAll("[data-duplicate]").forEach((button) => button.addEventListener("click", () => showToast("La duplicación estará disponible en una próxima etapa.")));
        document.querySelector("#cancel").addEventListener("click", showList);
        document.querySelector("#save-exit").addEventListener("click", () => { saveDraft(); showList(); showToast("La propiedad quedó guardada como borrador."); });
        document.querySelector("#cover-save-exit").addEventListener("click", () => { saveDraft(); showList(); showToast("La propiedad quedó guardada como borrador."); });
        document.querySelector("#property-save-exit").addEventListener("click", () => { saveDraft(); showList(); showToast("La propiedad quedó guardada como borrador."); });
        document.querySelector("#data-save-exit").addEventListener("click", () => { saveDraft(); showList(); showToast("La propiedad quedó guardada como borrador."); });
        document.querySelector("#cover-back").addEventListener("click", () => { saveDraft(); setStep(1); });
        document.querySelector("#property-back").addEventListener("click", () => { saveDraft(); setStep(2); });
        document.querySelector("#data-back").addEventListener("click", () => { saveDraft(); setStep(3); });
        document.querySelector("#gallery-back").addEventListener("click", () => { saveDraft(); setStep(4); });
        document.querySelector("#gallery-save-exit").addEventListener("click", () => { saveDraft(); showList(); showToast("La galería quedó guardada como borrador."); });
        document.querySelector("#features-back").addEventListener("click", () => { saveDraft(); setStep(5); });
        document.querySelector("#features-save-exit").addEventListener("click", () => { saveDraft(); showList(); showToast("Las características quedaron guardadas como borrador."); });
        document.querySelector("#location-back").addEventListener("click", () => { saveDraft(); setStep(6); });
        document.querySelector("#location-save-exit").addEventListener("click", () => { saveDraft(); showList(); showToast("La ubicación quedó guardada como borrador."); });
        document.querySelector("#distances-back").addEventListener("click", () => { saveDraft(); setStep(7); });
        document.querySelector("#distances-save-exit").addEventListener("click", () => { saveDraft(); showList(); showToast("Las distancias quedaron guardadas como borrador."); });
        document.querySelector("#review-back").addEventListener("click", () => { saveDraft(); setStep(8); });
        document.querySelector("#review-save-exit").addEventListener("click", () => { saveDraft(); showList(); showToast("La revisión quedó guardada en el borrador."); });
        document.querySelector("#prepare-presentation").addEventListener("click", () => { saveDraft(); openPreparation(); });
        document.querySelector("#close-preparation").addEventListener("click", closePreparation);
        document.querySelector("#preparation-cancel").addEventListener("click", closePreparation);
        document.querySelector("#preparation-cover-select").addEventListener("click", () => preparationCoverInput.click());
        document.querySelector("#preparation-gallery-select").addEventListener("click", () => preparationGalleryInput.click());
        document.querySelector("#preparation-video-select").addEventListener("click", () => preparationVideoInput.click());
        preparationCoverInput.addEventListener("change", () => { const file = preparationCoverInput.files[0]; if (!file) return; if (!isJpegFile(file)) { showToast("Usá una imagen JPG o JPEG."); preparationCoverInput.value = ""; return; } packageCoverFile = file; refreshPackageSummary(); });
        preparationGalleryInput.addEventListener("change", () => { const files = [...preparationGalleryInput.files]; if (files.some((file) => !isJpegFile(file))) { showToast("Usá una imagen JPG o JPEG."); preparationGalleryInput.value = ""; return; } packageGalleryFiles = files; applyFutureCover(); renderPackageGallery(); refreshPackageSummary(); });
        preparationVideoInput.addEventListener("change", () => { const file = preparationVideoInput.files[0]; if (!file) return; if (!isMp4File(file)) { showToast("El video seleccionado no es MP4."); preparationVideoInput.value = ""; return; } packageVideoFile = file; refreshPackageSummary(); });
        downloadPackage.addEventListener("click", downloadPreparedPackage);
        continuePublication.addEventListener("click", openPublicationGuide);
        document.querySelector("#close-publication").addEventListener("click", closePublicationGuide);
        document.querySelector("#close-publication-bottom").addEventListener("click", closePublicationGuide);
        document.querySelector("#open-preview").addEventListener("click", openExpectedPreview);
        document.querySelector("#add-featured-data").addEventListener("click", () => {
          const card = addDataCard();
          card.querySelector("[data-field='label']").focus();
          scheduleSave();
        });
        document.querySelector("#add-feature").addEventListener("click", () => addFeature());
        propertyDescriptionInput.addEventListener("input", scheduleSave);

        document.querySelectorAll(".step").forEach((step) => step.addEventListener("click", () => {
          const number = Number(step.dataset.step);
          if (number === 1) setStep(1);
          else if (number === 2) {
            if (!nameInput.value.trim()) {
              nameError.textContent = "Escribí el nombre de la propiedad para continuar.";
              nameInput.setAttribute("aria-invalid", "true");
              setStep(1);
              nameInput.focus();
            } else {
              saveDraft();
              setStep(2);
            }
          }
          else if (number === 3) {
            if (!nameInput.value.trim()) {
              nameError.textContent = "Escribí el nombre de la propiedad para continuar.";
              nameInput.setAttribute("aria-invalid", "true");
              setStep(1);
              nameInput.focus();
            } else if (!photoName.textContent) {
              setStep(2);
              photoError.textContent = "Seleccioná una foto principal para continuar.";
              photoDropzone.focus();
            } else if (document.querySelector('input[name="videoEnabled"]:checked').value === "yes" && !videoName.textContent) {
              setStep(2);
              videoError.textContent = "Seleccioná un video MP4 o elegí No.";
              document.querySelector("#select-video").focus();
            } else {
              saveDraft();
              setStep(3);
            }
          }
          else if (number === 4) {
            if (!nameInput.value.trim()) {
              nameError.textContent = "Escribí el nombre de la propiedad para continuar.";
              nameInput.setAttribute("aria-invalid", "true");
              setStep(1);
              nameInput.focus();
            } else if (!photoName.textContent) {
              setStep(2);
              photoError.textContent = "Seleccioná una foto principal para continuar.";
              photoDropzone.focus();
            } else if (document.querySelector('input[name="videoEnabled"]:checked').value === "yes" && !videoName.textContent) {
              setStep(2);
              videoError.textContent = "Seleccioná un video MP4 o elegí No.";
              document.querySelector("#select-video").focus();
            } else {
              saveDraft();
              setStep(4);
            }
          }
          else if (number === 5) { saveDraft(); setStep(5); }
          else if (number === 6) { saveDraft(); setStep(6); }
          else if (number === 7) { saveDraft(); setStep(7); }
          else if (number === 8) { saveDraft(); setStep(8); }
          else if (number === 9) { saveDraft(); setStep(9); }
          else showToast("Este paso se desarrollará en una próxima etapa.");
        }));

        [nameInput, priceInput, coverDescription].forEach((input) => input.addEventListener("input", () => {
          if (input === nameInput && nameInput.value.trim()) {
            nameError.textContent = "";
            nameInput.removeAttribute("aria-invalid");
          }
          if (input === nameInput) updateMediaStatus();
          scheduleSave();
        }));

        form.addEventListener("submit", (event) => {
          event.preventDefault();
          if (!nameInput.value.trim()) {
            nameError.textContent = "Escribí el nombre de la propiedad para continuar.";
            nameInput.setAttribute("aria-invalid", "true");
            nameInput.focus();
            return;
          }
          saveDraft();
          setStep(2);
          window.scrollTo({ top: 0, behavior: "smooth" });
        });

        const choosePhoto = () => photoInput.click();
        document.querySelector("#select-photo").addEventListener("click", (event) => { event.stopPropagation(); choosePhoto(); });
        document.querySelector("#change-photo").addEventListener("click", (event) => { event.stopPropagation(); choosePhoto(); });
        document.querySelector("#remove-photo").addEventListener("click", (event) => { event.stopPropagation(); clearPhoto(); });
        photoDropzone.addEventListener("click", () => { if (!photoDropzone.classList.contains("has-file")) choosePhoto(); });
        photoDropzone.addEventListener("keydown", (event) => {
          if ((event.key === "Enter" || event.key === " ") && !photoDropzone.classList.contains("has-file")) {
            event.preventDefault();
            choosePhoto();
          }
        });
        ["dragenter", "dragover"].forEach((name) => photoDropzone.addEventListener(name, (event) => {
          event.preventDefault();
          photoDropzone.classList.add("dragging");
        }));
        ["dragleave", "drop"].forEach((name) => photoDropzone.addEventListener(name, (event) => {
          event.preventDefault();
          photoDropzone.classList.remove("dragging");
        }));
        photoDropzone.addEventListener("drop", (event) => {
          const file = [...event.dataTransfer.files].find((item) => item.type.startsWith("image/"));
          if (!file) {
            photoError.textContent = "Seleccioná un archivo de imagen.";
            return;
          }
          selectedPhoto = file;
          photoRemoved = false;
          if (photoObjectUrl) URL.revokeObjectURL(photoObjectUrl);
          photoObjectUrl = URL.createObjectURL(file);
          showPhoto(photoObjectUrl, file.name);
          scheduleSave();
        });
        photoInput.addEventListener("change", () => {
          const file = photoInput.files[0];
          if (!file) return;
          selectedPhoto = file;
          photoRemoved = false;
          if (photoObjectUrl) URL.revokeObjectURL(photoObjectUrl);
          photoObjectUrl = URL.createObjectURL(file);
          showPhoto(photoObjectUrl, file.name);
          scheduleSave();
        });

        document.querySelectorAll('input[name="videoEnabled"]').forEach((input) => input.addEventListener("change", () => {
          setVideoEnabled(input.value === "yes");
          scheduleSave();
        }));
        const chooseVideo = () => videoInput.click();
        document.querySelector("#select-video").addEventListener("click", chooseVideo);
        document.querySelector("#change-video").addEventListener("click", chooseVideo);
        document.querySelector("#remove-video").addEventListener("click", clearVideo);
        videoInput.addEventListener("change", () => {
          const file = videoInput.files[0];
          if (!file) return;
          if (file.type !== "video/mp4" && !file.name.toLowerCase().endsWith(".mp4")) {
            videoError.textContent = "Seleccioná un video en formato MP4.";
            videoInput.value = "";
            return;
          }
          selectedVideo = file;
          videoRemoved = false;
          showVideo(file.name);
          scheduleSave();
        });

        coverForm.addEventListener("submit", (event) => {
          event.preventDefault();
          if (!photoName.textContent) {
            photoError.textContent = "Seleccioná una foto principal para continuar.";
            photoDropzone.focus();
            return;
          }
          if (document.querySelector('input[name="videoEnabled"]:checked').value === "yes" && !videoName.textContent) {
            videoError.textContent = "Seleccioná un video MP4 o elegí No.";
            document.querySelector("#select-video").focus();
            return;
          }
          saveDraft();
          setStep(3);
          window.scrollTo({ top: 0, behavior: "smooth" });
        });

        propertyForm.addEventListener("submit", (event) => {
          event.preventDefault();
          saveDraft();
          setStep(4);
          window.scrollTo({ top: 0, behavior: "smooth" });
        });

        dataForm.addEventListener("submit", (event) => {
          event.preventDefault(); saveDraft(); setStep(5); window.scrollTo({ top: 0, behavior: "smooth" });
        });
        galleryForm.addEventListener("submit", (event) => {
          event.preventDefault(); saveDraft(); setStep(6); window.scrollTo({ top: 0, behavior: "smooth" });
        });
        featuresForm.addEventListener("submit", (event) => {
          event.preventDefault(); saveDraft(); setStep(7); window.scrollTo({ top: 0, behavior: "smooth" });
        });
        locationForm.addEventListener("submit", (event) => {
          event.preventDefault(); saveDraft(); setStep(8); window.scrollTo({ top: 0, behavior: "smooth" });
        });
        distancesForm.addEventListener("submit", (event) => {
          event.preventDefault(); saveDraft(); setStep(9); window.scrollTo({ top: 0, behavior: "smooth" });
        });
        document.querySelector("#add-distance").addEventListener("click", addDistance);
        document.querySelectorAll('input[name="distancesEnabled"]').forEach((input) => input.addEventListener("change", () => { renderDistances(); scheduleSave(); }));
        document.querySelectorAll('input[name="locationEnabled"]').forEach((input) => input.addEventListener("change", () => { renderLocation(); scheduleSave(); }));
        [locationNameInput, locationAddressInput, latitudeInput, longitudeInput].forEach((input) => input.addEventListener("input", () => { renderLocation(); scheduleSave(); }));
        document.querySelectorAll('input[name="galleryEnabled"]').forEach((input) => input.addEventListener("change", () => { renderGallery(); scheduleSave(); }));
        document.querySelector("#gallery-select").addEventListener("click", (event) => { event.stopPropagation(); galleryInput.click(); });
        galleryDropzone.addEventListener("click", () => galleryInput.click());
        document.querySelector("#upload-gallery-r2").addEventListener("click", async () => {
          const queued = galleryItems.filter((item) => item.file && (item.status === "pending" || item.status === "error"));
          if (!queued.length) return showToast("No hay fotos pendientes para subir.");
          for (const item of queued) { item.status = "uploading"; item.progress = 0; renderGallery(); try { const result = await uploadR2File("gallery", item.file, item.id, (value) => { item.progress = value; document.querySelector("#gallery-upload-progress").textContent = "Subiendo fotos: " + galleryItems.filter((x) => x.status === "uploaded").length + " de " + galleryItems.length + " completadas"; renderGallery(); }); item.remoteUrl = result.publicUrl; item.objectKey = result.key; item.status = "uploaded"; item.source = item.remoteUrl; delete item.file; } catch { item.status = "error"; } renderGallery(); scheduleSave(); }
        });
        document.querySelector("#upload-cover-r2").addEventListener("click", async () => { if (!selectedPhoto || !isR2Image(selectedPhoto) || selectedPhoto.size > r2ImageLimit) return showToast("Elegí una imagen JPG, PNG o WEBP dentro del tamaño permitido."); try { document.querySelector("#cover-upload-progress").textContent = "Subiendo foto…"; const result = await uploadR2File("cover", selectedPhoto, "", (value) => document.querySelector("#cover-upload-progress").textContent = "Subiendo foto… " + value + "%"); remoteCover = { url: result.publicUrl, objectKey: result.key, contentType: selectedPhoto.type }; document.querySelector("#cover-upload-progress").textContent = "✓ Subida"; scheduleSave(); } catch { document.querySelector("#cover-upload-progress").textContent = "⚠ No se pudo subir la foto."; } });
        document.querySelector("#upload-video-r2").addEventListener("click", async () => { if (!selectedVideo || !isMp4File(selectedVideo) || selectedVideo.size > r2VideoLimit) return showToast("Elegí un video MP4 dentro del tamaño permitido."); try { document.querySelector("#video-upload-progress").textContent = "Subiendo video…"; const result = await uploadR2File("video", selectedVideo, "", (value) => document.querySelector("#video-upload-progress").textContent = "Subiendo video… " + value + "%"); remoteVideo = { url: result.publicUrl, objectKey: result.key, contentType: selectedVideo.type }; document.querySelector("#video-upload-progress").textContent = "✓ Subido"; scheduleSave(); } catch { document.querySelector("#video-upload-progress").textContent = "⚠ No se pudo subir el video."; } });
        r2Notice();
        galleryInput.addEventListener("change", () => { addTemporaryGalleryFiles(galleryInput.files); galleryInput.value = ""; });
        ["dragenter", "dragover"].forEach((name) => galleryDropzone.addEventListener(name, (event) => { event.preventDefault(); galleryDropzone.classList.add("dragging"); }));
        ["dragleave", "drop"].forEach((name) => galleryDropzone.addEventListener(name, (event) => { event.preventDefault(); galleryDropzone.classList.remove("dragging"); }));
        galleryDropzone.addEventListener("drop", (event) => addTemporaryGalleryFiles(event.dataTransfer.files));
        renderDraftCards();
      })();
    </script>
  </body>
</html>

