        const renderPublishedOrDraftCard = (draft: StoredProperty, isPublished: boolean) => {
          const card = document.createElement("article");
          card.className = "property-card draft-card";
          card.dataset.draftCard = draft.id;
          card.innerHTML = `
            <div class="draft-thumb" aria-hidden="true"></div>
