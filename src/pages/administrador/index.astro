        const slugify = (value) => value
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .trim()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-|-$/g, "");

        const readDrafts = () => {
          try {
            return JSON.parse(localStorage.getItem(storageKey) || "{}");
          } catch {
            return {};
          }
        };

        const writeDrafts = (drafts) => localStorage.setItem(storageKey, JSON.stringify(drafts));

        const subtitleFromLocation = () => {
          const visibleName = locationNameInput?.value.trim();
          if (!visibleName) return legacySubtitle;
          const parts = visibleName.split(",").map((part) => part.trim()).filter(Boolean);
          if (!parts.some((part) => part.toLowerCase() === "uruguay")) parts.push("Uruguay");
          return parts.join(" · ");
        };
        const descriptionParagraphs = (description) => description.split(/\n\s*\n/).map((item) => item.trim()).filter(Boolean);
        const currentValues = () => ({
          id: editingId || ("draft-" + Date.now()),
          slug: slugify(nameInput.value) || "nueva-propiedad",
          name: nameInput.value.trim(),
          price: priceInput.value.trim(),
          subtitle: subtitleFromLocation(),
          coverDescription: coverDescription.value.trim(),
          coverPhotoName: selectedPhoto?.name || photoName.textContent || "",
