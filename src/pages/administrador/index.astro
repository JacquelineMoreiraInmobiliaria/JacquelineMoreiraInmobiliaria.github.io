            { icon: "pool", label: "Piscina + jacuzzi", value: "Climatizada", show: true }
          ],
          galleryEnabled: true,
          galleryItems: [
            "hero.jpg", "atardecer.jpg", "piscina.jpg", "campo.jpg", "living.jpg", "cocina.jpg", "dormitorio-1.jpg", "living-4.jpg"
